;; Float arithmetic: Mandelbrot membership count on a 300x300 grid, 100 iterations.
;; F+/F-/F*/F//F</FLOAT are the asm port's float operators; run.sh rewrites
;; them to the generic + - * / < FLOAT for the Rust and SBCL hosts.
(defun iter (cx cy)
  (let ((zx 0.0) (zy 0.0) (i 0) (tx 0.0))
    (while (and (< i 100) (F< (F+ (F* zx zx) (F* zy zy)) 4.0))
      (setq tx (F+ (F- (F* zx zx) (F* zy zy)) cx))
      (setq zy (F+ (F* 2.0 (F* zx zy)) cy))
      (setq zx tx)
      (setq i (+ i 1)))
    i))
(defun run (n)
  (let ((y 0) (x 0) (c 0) (fn (FLOAT n)))
    (while (< y n)
      (setq x 0)
      (while (< x n)
        (if (= (iter (F- (F* 2.5 (F/ (FLOAT x) fn)) 2.0)
                     (F- (F* 2.5 (F/ (FLOAT y) fn)) 1.25))
               100)
            (setq c (+ c 1))
            0)
        (setq x (+ x 1)))
      (setq y (+ y 1)))
    c))
(print (run 300))
;; scaled: (print (run 800))

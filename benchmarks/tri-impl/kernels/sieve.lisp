;; Array work: sieve of Eratosthenes to 10^6 (78498 primes), 3 times.
(defun sieve (n)
  (let ((a (ARRAY (+ n 1))) (k 0) (i 2) (c 0) (lim (+ n 1)))
    (while (< k lim) (STORE a k 0) (setq k (+ k 1)))
    (while (< i lim)
      (if (= (FETCH a i) 0)
          (let ((j (* i i)))
            (setq c (+ c 1))
            (while (< j lim) (STORE a j 1) (setq j (+ j i))))
          0)
      (setq i (+ i 1)))
    c))
(defun run (reps)
  (let ((r 0) (tot 0))
    (while (< r reps) (setq tot (+ tot (sieve 1000000))) (setq r (+ r 1)))
    tot))
(print (run 3))
;; scaled: (print (run 30))

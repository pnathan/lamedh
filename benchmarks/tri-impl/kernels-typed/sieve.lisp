;; Typed-JIT edition of kernels/sieve.lisp (MAKE-ARRAY/AREF/ASET are the
;; typed tier's spellings of ARRAY/FETCH/STORE).
(defun-typed (sieve int64) ((n int64))
  (let ((a (make-array (+ n 1))) (k 0) (i 2) (c 0) (lim (+ n 1)))
    (while (< k lim) (aset a k 0) (setq k (+ k 1)))
    (while (< i lim)
      (if (= (aref a i) 0)
          (let ((j (* i i)))
            (setq c (+ c 1))
            (while (< j lim) (aset a j 1) (setq j (+ j i)))
            0)
          0)
      (setq i (+ i 1)))
    c))
(defun-typed (run int64) ((reps int64))
  (let ((r 0) (tot 0))
    (while (< r reps) (setq tot (+ tot (sieve 1000000))) (setq r (+ r 1)))
    tot))
(if (eq (compiled-p 'sieve) 'native) nil (error "sieve: not NATIVE"))
(if (eq (compiled-p 'run) 'native) nil (error "run: not NATIVE"))
(print (run 3))

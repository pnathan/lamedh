;; Typed-JIT edition of kernels/mandel.lisp.
(defun-typed (iter int64) ((cx float64) (cy float64))
  (let ((zx 0.0) (zy 0.0) (i 0) (tx 0.0))
    (while (and (< i 100) (< (+ (* zx zx) (* zy zy)) 4.0))
      (setq tx (+ (- (* zx zx) (* zy zy)) cx))
      (setq zy (+ (* 2.0 (* zx zy)) cy))
      (setq zx tx)
      (setq i (+ i 1)))
    i))
(defun-typed (run int64) ((n int64))
  (let ((y 0) (x 0) (c 0) (fn (float n)))
    (while (< y n)
      (setq x 0)
      (while (< x n)
        (if (= (iter (- (* 2.5 (/ (float x) fn)) 2.0)
                     (- (* 2.5 (/ (float y) fn)) 1.25))
               100)
            (setq c (+ c 1))
            0)
        (setq x (+ x 1)))
      (setq y (+ y 1)))
    c))
(if (eq (compiled-p 'iter) 'native) nil (error "iter: not NATIVE"))
(if (eq (compiled-p 'run) 'native) nil (error "run: not NATIVE"))
(print (run 300))
